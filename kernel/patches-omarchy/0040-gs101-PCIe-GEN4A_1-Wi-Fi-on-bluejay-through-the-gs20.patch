+	if (platform_get_resource_byname(pdev, IORESOURCE_MEM, "udbg")) {
+		gp->udbg = devm_platform_ioremap_resource_byname(pdev, "udbg");
+		if (IS_ERR(gp->udbg))
+			return PTR_ERR(gp->udbg);
+	}
 
 	gp->pmu = exynos_get_pmu_regmap_by_phandle(dev->of_node,
 						   "samsung,pmu-syscon");
@@ -615,8 +678,22 @@ static int gs201_pcie_phy_probe(struct platform_device *pdev)
 	return PTR_ERR_OR_ZERO(provider);
 }
 
