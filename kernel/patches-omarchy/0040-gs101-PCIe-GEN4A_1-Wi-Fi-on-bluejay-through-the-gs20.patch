From ec780ef39150526f27f69c4cb7792bca5f6fadb6 Mon Sep 17 00:00:00 2001
From: Buon-Omba <302052335+Buon-Omba@users.noreply.github.com>
Date: Thu, 5 Nov 2026 14:58:36 +0100
Subject: [PATCH 40/47] gs101: PCIe GEN4A_1 Wi-Fi on bluejay through the gs201
 drivers

PHY: a gs101 variant of phy-gs201-pcie with the gs101 PMA tables from
Google's pcie-exynos-gs101-rc-cal.c (google-modules/soc/gs,
android-gs-raviole-6.1-android16 @204078758737): no 38.4 MHz input
clock block, gs101 TX/RX tuning, no PCS rate control or PLL/bias delay.
udbg made optional. Host: google,gs101-pcie on the same driver.
DT: pcie_1 and its PHY in gs101.dtsi (addresses, SPI 509 and HSI2
clocks from stock gs101), bluejay's WL_REG_ON (gpp14-2), wake pins and
PHY rails (LDO17M/LDO19M) from the stock CP2A dtbo, and a restricted
DMA pool as on gs201-cheetah.
---
 .../boot/dts/exynos/google/gs101-bluejay.dts  |  97 +++++++++++++++
 .../dts/exynos/google/gs101-pixel-common.dtsi |   4 +-
 arch/arm64/boot/dts/exynos/google/gs101.dtsi  |  63 ++++++++++
 drivers/pci/controller/dwc/pcie-gs201.c       |   1 +
 drivers/phy/samsung/phy-gs201-pcie.c          | 113 +++++++++++++++---
 5 files changed, 258 insertions(+), 20 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/google/gs101-bluejay.dts b/arch/arm64/boot/dts/exynos/google/gs101-bluejay.dts
index 7a8d31a47..28cf01706 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101-bluejay.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs101-bluejay.dts
@@ -7,6 +7,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/gpio/gpio.h>
 #include "gs101-pixel-common.dtsi"
 
 / {
@@ -18,6 +19,18 @@ reserved-memory {
 		#address-cells = <2>;
 		#size-cells = <1>;
 
+		/*
+		 * All of the Wi-Fi chip's DMA buffers come from this pool (as on
+		 * gs201-cheetah, omarchy-mobile PR #143); the chip does not see its
+		 * writes above 4 GiB.
+		 */
+		wifi_dma_pool: wifi-dma-pool {
+			compatible = "restricted-dma-pool";
+			size = <0x1000000>;
+			alignment = <0x0 0x200000>;
+			alloc-ranges = <0x0 0x80000000 0x80000000>;
+		};
+
 		ramoops@fd3ff000 {
 			compatible = "ramoops";
 			reg = <0x0 0xfd3ff000 0x400000>;
@@ -49,3 +62,87 @@ &spitouch {
 	fts,x-max = <1080>;
 	fts,y-max = <2400>;
 };
+
+/*
+ * Wi-Fi: BCM4389 on PCIe GEN4A_1 (pcie_1), one lane at Gen2 as on stock bluejay
+ * (CP2A.260705.006 dtbo, board 0x20506): WL_REG_ON gpp14-2, host wake gpa7-0,
+ * device wake gph2-5, PHY rails LDO17M (0.85 V) and LDO19M (1.8 V).
+ */
+/ {
+	wlan_pwr: regulator-wlan {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan-reg-on";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&gpp14 2 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		/* Google raises WL_REG_ON and waits 200 ms before link training */
+		startup-delay-us = <200000>;
+		pinctrl-0 = <&wlan_reg_on>;
+		pinctrl-names = "default";
+	};
+};
+
+&ldo17m_reg {
+	regulator-always-on;
+};
+
+&ldo19m_reg {
+	regulator-always-on;
+};
+
+&pinctrl_peric0 {
+	wlan_reg_on: wlan-reg-on-pins {
+		samsung,pins = "gpp14-2";
+		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
+		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
+	};
+};
+
+&pinctrl_far_alive {
+	wlan_host_wake: wlan-host-wake-pins {
+		samsung,pins = "gpa7-0";
+		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
+		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
+		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
+	};
+};
+
+&pinctrl_hsi2 {
+	wlan_dev_wake: wlan-dev-wake-pins {
+		samsung,pins = "gph2-5";
+		samsung,pin-function = <GS101_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <GS101_PIN_PULL_DOWN>;
+		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
+	};
+};
+
+&pcie_1 {
+	status = "okay";
+	pinctrl-0 = <&pcie1_clkreq>, <&pcie1_perst>, <&wlan_dev_wake>,
+		    <&wlan_host_wake>;
+	pinctrl-names = "default";
+
+	pcie@0,0 {
+		compatible = "pciclass,0604";
+		device_type = "pci";
+		reg = <0x0 0x0 0x0 0x0 0x0>;
+		bus-range = <0x01 0xff>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+		vpcie3v3-supply = <&wlan_pwr>;
+
+		wifi@0,0 {
+			compatible = "pci14e4,4441";
+			reg = <0x10000 0x0 0x0 0x0 0x0>;
+			brcm,board-type = "google,gs101-bluejay";
+			memory-region = <&wifi_dma_pool>;
+		};
+	};
+};
+
+&pcie_1_phy {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi b/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi
index 09349d47c..226cda8f3 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi
@@ -361,7 +361,7 @@ ldo16m {
 				regulator-max-microvolt = <1300000>;
 			};
 
-			ldo17m {
+			ldo17m_reg: ldo17m {
 				regulator-name = "vdd085_pcie1";
 				regulator-min-microvolt = <725000>;
 				regulator-max-microvolt = <1300000>;
@@ -373,7 +373,7 @@ ldo18m {
 				regulator-max-microvolt = <1950000>;
 			};
 
-			ldo19m {
+			ldo19m_reg: ldo19m {
 				regulator-name = "vdd18_pcie1";
 				regulator-min-microvolt = <1600000>;
 				regulator-max-microvolt = <1950000>;
diff --git a/arch/arm64/boot/dts/exynos/google/gs101.dtsi b/arch/arm64/boot/dts/exynos/google/gs101.dtsi
index d0d24fb07..dc2f17cec 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs101.dtsi
@@ -1739,6 +1739,69 @@ sysreg_hsi2: syscon@14420000 {
 			clocks = <&cmu_hsi2 CLK_GOUT_HSI2_SYSREG_HSI2_PCLK>;
 		};
 
+		/*
+		 * PCIe GEN4A_1 in HSI2: the Wi-Fi controller (Google's pcie_1, ch-num 1).
+		 * Same block and addresses as gs201's; stock gs101 runs it at one lane, Gen2,
+		 * with I/A, without SysMMU and without cache coherency.
+		 */
+		pcie_1: pcie@14520000 {
+			compatible = "google,gs101-pcie";
+			reg = <0x14520000 0x1400>,
+			      <0x14800000 0x301000>,
+			      <0x60ffe000 0x2000>,
+			      <0x14500000 0x1000>;
+			reg-names = "elbi", "dbi", "config", "ia";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			device_type = "pci";
+			ranges = <0x82000000 0x0 0x60000000 0x60000000 0x0 0xff0000>;
+			bus-range = <0x00 0xff>;
+			interrupts = <GIC_SPI 509 IRQ_TYPE_LEVEL_HIGH 0>;
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &pcie_1_intc 1>,
+					<0 0 0 2 &pcie_1_intc 2>,
+					<0 0 0 3 &pcie_1_intc 3>,
+					<0 0 0 4 &pcie_1_intc 4>;
+			clocks = <&cmu_hsi2 CLK_GOUT_HSI2_PCIE_GEN4_1_PCIE_003_DBI_ACLK_UG>,
+				 <&cmu_hsi2 CLK_GOUT_HSI2_PCIE_GEN4_1_PCIE_003_MSTR_ACLK_UG>,
+				 <&cmu_hsi2 CLK_GOUT_HSI2_PCIE_GEN4_1_PCIE_003_SLV_ACLK_UG>,
+				 <&cmu_hsi2 CLK_GOUT_HSI2_PCIE_GEN4_1_PCIE_003_I_DRIVER_APB_CLK>,
+				 <&cmu_hsi2 CLK_GOUT_HSI2_PCIE_IA_GEN4A_1_I_CLK>,
+				 <&cmu_hsi2 CLK_GOUT_HSI2_QE_PCIE_GEN4A_HSI2_ACLK>,
+				 <&cmu_hsi2 CLK_GOUT_HSI2_QE_PCIE_GEN4A_HSI2_PCLK>;
+			phys = <&pcie_1_phy>;
+			phy-names = "pcie";
+			pinctrl-0 = <&pcie1_clkreq>, <&pcie1_perst>;
+			pinctrl-names = "default";
+			reset-gpios = <&gph2 0 GPIO_ACTIVE_LOW>;
+			samsung,cmu = <&cmu_hsi2>;
+			num-lanes = <1>;
+			max-link-speed = <2>;
+			status = "disabled";
+
+			pcie_1_intc: legacy-interrupt-controller {
+				#address-cells = <0>;
+				interrupt-controller;
+				#interrupt-cells = <1>;
+			};
+		};
+
+		pcie_1_phy: phy@14550000 {
+			compatible = "google,gs101-pcie-phy";
+			reg = <0x14550000 0x2000>,
+			      <0x14540000 0x1000>,
+			      <0x14521400 0x10>;
+			reg-names = "pma", "pcs", "rst";
+			clocks = <&cmu_hsi2 CLK_GOUT_HSI2_PCIE_GEN4_1_PCIE_003_PHY_REFCLK_IN>,
+				 <&cmu_hsi2 CLK_GOUT_HSI2_PCIE_GEN4_1_PCS_PMA_PHY_UDBG_I_APB_PCLK>,
+				 <&cmu_hsi2 CLK_GOUT_HSI2_PCIE_GEN4_1_PCS_PMA_PIPE_PAL_PCIE_I_APB_PCLK>,
+				 <&cmu_hsi2 CLK_GOUT_HSI2_PCIE_GEN4_1_PCS_PMA_PCIEPHY210X2_QCH_I_APB_PCLK>;
+			samsung,pmu-syscon = <&pmu_system_controller 0x3ec4>;
+			#phy-cells = <0>;
+			status = "disabled";
+		};
+
 		pinctrl_hsi2: pinctrl@14440000 {
 			compatible = "google,gs101-pinctrl";
 			reg = <0x14440000 0x00001000>;
diff --git a/drivers/pci/controller/dwc/pcie-gs201.c b/drivers/pci/controller/dwc/pcie-gs201.c
index af650d763..c0c5af77e 100644
