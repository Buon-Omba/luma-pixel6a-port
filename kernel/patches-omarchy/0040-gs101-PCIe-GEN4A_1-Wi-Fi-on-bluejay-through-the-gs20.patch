-					   gs201_pma_lane,
-					   ARRAY_SIZE(gs201_pma_lane));
+					   gp->data->lane, gp->data->n_lane);
 
-	for (lane = 0; lane < GS201_PHY_MAX_LANES; lane++)
+	for (lane = 0; gp->data->n_lane_clk && lane < GS201_PHY_MAX_LANES; lane++)
 		gs201_pcie_phy_write_table(gp->pma + lane * GS201_PMA_LANE_STRIDE,
-					   gs201_pma_lane_clk,
-					   ARRAY_SIZE(gs201_pma_lane_clk));
+					   gp->data->lane_clk, gp->data->n_lane_clk);
 
 	gs201_phy_trace(gp, "about to write PCS 0x004 0x154 0x150 0x170 0x008 0x190");
 	for (lane = 0; lane < lanes; lane++) {
@@ -359,8 +415,9 @@ static void gs201_pcie_phy_config(struct gs201_pcie_phy *gp, unsigned int lanes)
 				   GS201_PCS_ERIO_CLK_GATE_MASK,
 				   GS201_PCS_ERIO_CLK_GATE_MASK);
 
-	/* PLL and bias enable off delay */
-	writel(0x100b0808, gp->pcs + GS201_PCS_PLL_BIAS_OFF_DELAY);
+	/* PLL and bias enable off delay (gs201 only) */
+	if (gp->data->pll_bias_delay)
+		writel(0x100b0808, gp->pcs + GS201_PCS_PLL_BIAS_OFF_DELAY);
 
 	gs201_phy_trace(gp, "about to release CMN_RST and PORT_RST");
 	writel(1, gp->rst + GS201_PHY_RST_CMN);
@@ -570,6 +627,9 @@ static int gs201_pcie_phy_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	gp->dev = dev;
+	gp->data = of_device_get_match_data(dev);
+	if (!gp->data)
