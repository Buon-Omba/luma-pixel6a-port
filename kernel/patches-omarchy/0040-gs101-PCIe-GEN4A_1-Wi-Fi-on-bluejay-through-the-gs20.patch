 	/* Only mappings here: the PHY is not touched until phy_init() */
 	gp->pma = devm_platform_ioremap_resource_byname(pdev, "pma");
@@ -584,9 +644,12 @@ static int gs201_pcie_phy_probe(struct platform_device *pdev)
 	if (IS_ERR(gp->rst))
 		return PTR_ERR(gp->rst);
 
-	gp->udbg = devm_platform_ioremap_resource_byname(pdev, "udbg");
-	if (IS_ERR(gp->udbg))
