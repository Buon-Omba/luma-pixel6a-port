+
+struct gs201_pcie_phy_data {
+	const struct gs201_pcie_phy_reg *common, *lane, *lane_clk;
+	size_t n_common, n_lane, n_lane_clk;
+	bool pcs_rate_ctrl;	/* PCS 0x184 in power-down/clear (gs201) */
+	bool pll_bias_delay;	/* PCS 0x190 PLL & bias off delay (gs201) */
+};
+
 /* PHY power-down, per lane (offsets for lane 0) */
 static const struct gs201_pcie_phy_reg gs201_pma_lane_pwrdn[] = {
 	{ 0x800, 0x0a }, { 0x804, 0xbf }, { 0xa40, 0x02 }, { 0xa44, 0x2a },
@@ -184,6 +238,7 @@ static const struct gs201_pcie_phy_reg gs201_pma_reset_vals[] = {
 
 struct gs201_pcie_phy {
 	struct device *dev;
+	const struct gs201_pcie_phy_data *data;
 	void __iomem *pma;
 	void __iomem *pcs;
 	void __iomem *rst;
@@ -254,9 +309,11 @@ static void gs201_pcie_phy_pwrdn(struct gs201_pcie_phy *gp)
 	gs201_pcie_phy_rmw(gp->pma + GS201_PMA_CMN_CTRL,
 			   GS201_PMA_CMN_CTRL_PMA_EN, 0);
 
-	gs201_phy_trace(gp, "about to read PCS 0x184 (first PCS read): rate switching off");
-	gs201_pcie_phy_rmw(gp->pcs + GS201_PCS_RATE_CTRL,
-			   GS201_PCS_RATE_CTRL_SWITCH, 0);
+	if (gp->data->pcs_rate_ctrl) {
+		gs201_phy_trace(gp, "about to read PCS 0x184 (first PCS read): rate switching off");
+		gs201_pcie_phy_rmw(gp->pcs + GS201_PCS_RATE_CTRL,
+				   GS201_PCS_RATE_CTRL_SWITCH, 0);
+	}
 }
 
 static void gs201_pcie_phy_pwrdn_clear(struct gs201_pcie_phy *gp)
@@ -277,8 +334,10 @@ static void gs201_pcie_phy_pwrdn_clear(struct gs201_pcie_phy *gp)
 			writel(0, gp->pma + lane * GS201_PMA_LANE_STRIDE +
 			       gs201_pma_lane_pwrdn[i].off);
 
-	gs201_phy_trace(gp, "about to write PCS 0x184 (rate change and power-down reset)");
-	writel(0, gp->pcs + GS201_PCS_RATE_CTRL);
+	if (gp->data->pcs_rate_ctrl) {
+		gs201_phy_trace(gp, "about to write PCS 0x184 (rate change and power-down reset)");
+		writel(0, gp->pcs + GS201_PCS_RATE_CTRL);
+	}
 }
 
 /* Google's debug check that the PMA came out of reset with its defaults */
@@ -329,18 +388,15 @@ static void gs201_pcie_phy_config(struct gs201_pcie_phy *gp, unsigned int lanes)
 
 	gs201_phy_trace(gp, "about to write the PMA tables (common, %u lane(s), lane clocks)",
 			lanes);
-	gs201_pcie_phy_write_table(gp->pma, gs201_pma_common,
-				   ARRAY_SIZE(gs201_pma_common));
+	gs201_pcie_phy_write_table(gp->pma, gp->data->common, gp->data->n_common);
 
 	for (lane = 0; lane < lanes; lane++)
