From 2c6873bec65f52a928d6b9721c1ee5319d9db6e6 Mon Sep 17 00:00:00 2001
From: Buon-Omba <302052335+Buon-Omba@users.noreply.github.com>
Date: Thu, 5 Nov 2026 15:04:12 +0100
Subject: [PATCH 41/47] arm64: dts: gs101: map the PCIe windows below 2 GiB in
 soc@0

pcie_1's outbound window and config space sit at 0x60000000, outside
the 1 GiB soc@0 range; extend it as gs201 does (omarchy-mobile PR #143).
---
 arch/arm64/boot/dts/exynos/google/gs101.dtsi | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/google/gs101.dtsi b/arch/arm64/boot/dts/exynos/google/gs101.dtsi
index dc2f17cec..ed46002de 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs101.dtsi
@@ -574,7 +574,8 @@ soc: soc@0 {
 		compatible = "simple-bus";
 		#address-cells = <1>;
 		#size-cells = <1>;
-		ranges = <0x0 0x0 0x0 0x40000000>;
+		/* Registers below 1 GiB, PCIe windows at 0x40000000-0x7fffffff */
+		ranges = <0x0 0x0 0x0 0x80000000>;
 
 		efuse@10000000 {
 			compatible = "google,gs101-otp";
-- 
2.56.0

